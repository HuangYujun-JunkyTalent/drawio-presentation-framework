// A draw.io colour configuration to copy: replace the values, and load the three settings as the
// section "The colour configuration gives each hex value a name in the colour dialog" of
// README.md beside this file says, which also says what each setting does and the form of its
// values.  `named-colors-example.json` is this template filled in for an example deck,
// with the same names for the four colours below.
//
// This file is JSON with comments, so that it can name the part of draw.io that reads each
// setting.  Strip the comments for the mode `vscode` of `tools/draw-io/build-slides.py`, or paste
// each part into a VS Code `settings.json` under the name of the extension setting that the same
// section gives, because VS Code accepts comments there.
{
  // draw.io reads the names into `ColorDialog.prototype.colorNames`.
  "colorNames": {
    "0E8005": "cdF",
    "B30306": "cdR",
    "D6780A": "cdI",
    "004D7F": "cdK"
  },

  // draw.io reads the top row of the colour dialog into `ColorDialog.prototype.presetColors`.
  "presetColors": ["0E8005", "B30306", "D6780A", "004D7F", "000000", "FFFFFF"],

  // draw.io puts these rows of swatches before its own, in
  // `StyleFormatPanel.prototype.defaultColorSchemes`.
  "customColorSchemes": [
    [
      { "fill": "#0e8005", "stroke": "#0e8005", "font": "#ffffff" },
      { "fill": "#b30306", "stroke": "#b30306", "font": "#ffffff" },
      { "fill": "#d6780a", "stroke": "#d6780a", "font": "#ffffff" },
      { "fill": "#004d7f", "stroke": "#004d7f", "font": "#ffffff" }
    ],
    [
      { "fill": "none", "stroke": "#0e8005" },
      { "fill": "none", "stroke": "#b30306" },
      { "fill": "none", "stroke": "#d6780a" },
      { "fill": "none", "stroke": "#004d7f" }
    ]
  ]
}
